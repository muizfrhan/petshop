APP_NAME="PetCare House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Seluruh UI + validasi memakai Bahasa Indonesia
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# PostgreSQL (dikelola lewat pgAdmin 4). Driver MySQL (mysql:) juga didukung
# penuh oleh seluruh migration di project ini.
# Jangan pernah commit password: isi lewat .env lokal atau secret manager.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=petshop
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@petcarehouse.test"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk production: isi kredensial gateway di sini / di secret manager.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# XENDIT_SECRET_KEY=
# TRIPAY_API_KEY=

# Identitas toko (dipakai footer, fab WhatsApp, dan email)
PETSHP_STORE_NAME="PETCARE HOUSE"
PETSHP_WHATSAPP_NUMBER="6281234567890"
PETSHP_SUPPORT_EMAIL="cs@petcarehouse.test"
PETSHP_LOW_STOCK_THRESHOLD=10

VITE_APP_NAME="${APP_NAME}"